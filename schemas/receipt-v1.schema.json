{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BlockedPath/herdr-xray/schemas/receipt-v1.schema.json",
  "title": "Herdr X-Ray trust receipt v1",
  "description": "A bounded static-analysis observation. This is not a safety claim, signature, or attestation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tool",
    "generatedAt",
    "subject",
    "limits",
    "completeness",
    "summary",
    "graph",
    "findings",
    "comparison",
    "provenance",
    "analysisHash",
    "receiptHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tool": { "$ref": "#/$defs/tool" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "subject": { "$ref": "#/$defs/subject" },
    "limits": { "$ref": "#/$defs/limits" },
    "completeness": { "$ref": "#/$defs/completeness" },
    "summary": { "$ref": "#/$defs/summary" },
    "graph": { "$ref": "#/$defs/graph" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "comparison": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/comparison" }
      ]
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "analysisHash": { "$ref": "#/$defs/sha256" },
    "receiptHash": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "completeness": {
            "properties": { "complete": { "const": true } },
            "required": ["complete"]
          }
        },
        "required": ["completeness"]
      },
      "then": {
        "properties": {
          "subject": {
            "properties": {
              "source": {
                "properties": { "status": { "const": "resolved" } }
              },
              "plugin": { "$ref": "#/$defs/plugin" }
            }
          },
          "completeness": {
            "properties": {
              "unstable": { "const": false },
              "dimensions": {
                "properties": {
                  "source": { "properties": { "status": { "const": "complete" } } },
                  "manifest": { "properties": { "status": { "const": "complete" } } },
                  "executionGraph": { "properties": { "status": { "const": "complete" } } },
                  "reachableSource": { "properties": { "status": { "const": "complete" } } },
                  "analysis": { "properties": { "status": { "const": "complete" } } },
                  "cleanup": { "properties": { "status": { "const": "complete" } } }
                }
              }
            }
          },
          "provenance": {
            "properties": {
              "files": {
                "contains": {
                  "type": "object",
                  "properties": { "role": { "const": "manifest" } },
                  "required": ["role"]
                },
                "minContains": 1
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "platforms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["linux", "macos", "windows"]
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "rulesVersion"],
      "properties": {
        "name": { "const": "herdr-xray" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "rulesVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "display", "resolvedCommit", "localRootHash"],
      "properties": {
        "kind": { "enum": ["github", "local", "installed"] },
        "status": { "enum": ["resolved", "unresolved"] },
        "display": { "type": "string", "minLength": 1, "maxLength": 512 },
        "owner": { "type": "string", "minLength": 1, "maxLength": 100 },
        "repo": { "type": "string", "minLength": 1, "maxLength": 100 },
        "subdir": { "type": ["string", "null"], "maxLength": 1024 },
        "requestedRef": { "type": ["string", "null"], "maxLength": 512 },
        "resolvedCommit": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "localRootHash": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sha256" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "github" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["owner", "repo", "subdir", "requestedRef"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "github" },
              "status": { "const": "resolved" }
            },
            "required": ["kind", "status"]
          },
          "then": {
            "properties": {
              "resolvedCommit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40,64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "local" },
              "status": { "const": "resolved" }
            },
            "required": ["kind", "status"]
          },
          "then": {
            "properties": {
              "localRootHash": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      ]
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "minHerdrVersion", "platforms"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "minHerdrVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "platforms": { "$ref": "#/$defs/platforms" }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "plugin", "analysisHash"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "plugin": { "$ref": "#/$defs/plugin" },
        "analysisHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "plugin", "installedBaseline"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "plugin": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/plugin" }
          ]
        },
        "installedBaseline": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/baseline" }
          ]
        }
      }
    },
    "limits": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "completenessStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "limit"],
      "properties": {
        "status": { "enum": ["complete", "partial", "unavailable"] },
        "reason": { "type": ["string", "null"], "maxLength": 1024 },
        "limit": { "type": ["string", "null"], "maxLength": 128 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "complete" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "reason": { "type": "null" } }
          },
          "else": {
            "properties": {
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "unstable", "dimensions"],
      "properties": {
        "complete": { "type": "boolean" },
        "unstable": { "type": "boolean" },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "manifest", "executionGraph", "reachableSource", "analysis", "cleanup"],
          "properties": {
            "source": { "$ref": "#/$defs/completenessStatus" },
            "manifest": { "$ref": "#/$defs/completenessStatus" },
            "executionGraph": { "$ref": "#/$defs/completenessStatus" },
            "reachableSource": { "$ref": "#/$defs/completenessStatus" },
            "analysis": { "$ref": "#/$defs/completenessStatus" },
            "cleanup": { "$ref": "#/$defs/completenessStatus" },
            "marketplace": { "$ref": "#/$defs/completenessStatus" },
            "comparison": { "$ref": "#/$defs/completenessStatus" }
          }
        }
      }
    },
    "severityCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["info", "low", "medium", "high"],
      "properties": {
        "info": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facts", "heuristics", "unknowns", "bySeverity"],
      "properties": {
        "facts": { "type": "integer", "minimum": 0 },
        "heuristics": { "type": "integer", "minimum": 0 },
        "unknowns": { "type": "integer", "minimum": 0 },
        "bySeverity": { "$ref": "#/$defs/severityCounts" }
      }
    },
    "provenanceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["manifest", "source", "analyzer", "acquisition", "marketplace"] },
        "path": { "type": ["string", "null"], "maxLength": 2048 },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "column": { "type": ["integer", "null"], "minimum": 1 },
        "declaration": { "type": ["string", "null"], "maxLength": 256 },
        "analyzerId": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "graphNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "effectivePlatforms", "attributes"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "type": {
          "enum": [
            "plugin",
            "trigger",
            "command",
            "source-file",
            "package-lifecycle",
            "subprocess",
            "network-endpoint",
            "environment-variable",
            "filesystem-path",
            "opaque-binary",
            "unknown"
          ]
        },
        "label": { "type": "string", "maxLength": 1024 },
        "effectivePlatforms": { "$ref": "#/$defs/platforms" },
        "attributes": { "type": "object" }
      }
    },
    "graphEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "from", "to", "effectivePlatforms", "confidence", "provenance"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "type": {
          "enum": [
            "declares",
            "invokes",
            "imports",
            "sources",
            "spawns",
            "reads-environment",
            "reads-path",
            "writes-path",
            "connects-to",
            "resolves-dynamically",
            "could-not-resolve"
          ]
        },
        "from": { "type": "string", "minLength": 1, "maxLength": 256 },
        "to": { "type": "string", "minLength": 1, "maxLength": 256 },
        "effectivePlatforms": { "$ref": "#/$defs/platforms" },
        "confidence": { "enum": ["low", "medium", "high"] },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/provenanceRecord" }
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/graphNode" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/graphEdge" } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line", "column", "excerpt"],
      "properties": {
        "path": { "type": ["string", "null"], "maxLength": 2048 },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "column": { "type": ["integer", "null"], "minimum": 1 },
        "excerpt": { "type": ["string", "null"], "maxLength": 512 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ruleId",
        "class",
        "severity",
        "confidence",
        "category",
        "title",
        "explanation",
        "evidence",
        "remediation"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "ruleId": { "type": "string", "pattern": "^xray\\.[a-z0-9-]+\\.[a-z0-9-]+$" },
        "class": { "enum": ["fact", "heuristic", "unknown"] },
        "severity": { "enum": ["info", "low", "medium", "high"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "category": {
          "enum": ["identity", "execution", "network", "credential", "filesystem", "package", "opaque", "dynamic"]
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 256 },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "remediation": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "comparisonChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "change", "subject", "severity"],
      "properties": {
        "kind": { "enum": ["identity", "manifest", "graph", "finding", "completeness", "reachable-file"] },
        "change": { "enum": ["added", "removed", "changed"] },
        "subject": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "severity": { "enum": ["info", "low", "medium", "high"] }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baselineAnalysisHash", "changes"],
      "properties": {
        "baselineAnalysisHash": { "$ref": "#/$defs/sha256" },
        "changes": {
          "type": "array",
          "items": { "$ref": "#/$defs/comparisonChange" }
        }
      }
    },
    "fileProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "role"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 },
        "role": { "enum": ["manifest", "metadata", "reachable-source", "opaque"] }
      }
    },
    "analyzerProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestPath", "files", "analyzers"],
      "properties": {
        "manifestPath": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "files": { "type": "array", "items": { "$ref": "#/$defs/fileProvenance" } },
        "analyzers": { "type": "array", "items": { "$ref": "#/$defs/analyzerProvenance" } }
      }
    }
  }
}
